<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  :root{--navy:#1B3A5C;--navy-dark:#122845;--lime:#A8C840;--lime-dark:#8AAF28;--white:#FFFFFF;--off-white:#F5F6F4;--light:#EAECEB;--mid:#8A9099;--text:#1C2B3A;--text-light:#4A5A6A;--border:#D4D8DC;}
  @media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact;}.no-print{display:none !important;}}
  body{background:var(--white);color:var(--text);font-family:'Barlow',sans-serif;font-weight:400;line-height:1.6;}
  .no-print{position:fixed;top:16px;right:20px;z-index:100;}
  .print-btn{background:var(--navy);color:#fff;border:none;padding:10px 22px;font-family:'Barlow',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;border-radius:2px;}
  .wrap{max-width:900px;margin:0 auto;padding:0 0 80px;}

  /* HEADER */
  .header{background:var(--navy);padding:22px 48px 26px;position:relative;}
  .header::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:3px;background:var(--lime);}
  .header-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px;}
  .header-logo-mark{position:relative;width:34px;height:34px;flex:none;}
  .header-logo-mark .sq1{position:absolute;top:0;left:0;width:24px;height:24px;background:var(--lime);border-radius:2px;}
  .header-logo-mark .sq2{position:absolute;top:1px;right:0;width:14px;height:14px;background:var(--navy-dark);border:1px solid rgba(255,255,255,0.25);border-radius:1px;}
  .header-logo-mark .sq3{position:absolute;bottom:0;left:5px;width:12px;height:12px;background:var(--lime-dark);border-radius:1px;}
  .header-logo-text{line-height:1.2;}
  .header-logo-name{font-family:'Barlow Condensed',sans-serif;font-size:21px;font-weight:800;letter-spacing:0.02em;text-transform:uppercase;color:#fff;}
  .header-logo-tag{font-size:10px;font-weight:600;letter-spacing:0.13em;text-transform:uppercase;color:rgba(255,255,255,0.45);margin-top:1px;}
  .header-eyebrow{font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--lime);margin-bottom:18px;}
  .header-address{font-family:'Barlow Condensed',sans-serif;font-size:44px;font-weight:800;line-height:1.0;color:#fff;text-transform:uppercase;margin-bottom:8px;}
  .header-sub{font-family:'Barlow Condensed',sans-serif;font-size:21px;font-weight:700;letter-spacing:0.02em;text-transform:uppercase;color:var(--lime);}
  .header-summary{font-size:15.5px;color:rgba(255,255,255,0.82);line-height:1.75;font-weight:400;margin-top:22px;max-width:820px;}
  .header-summary p + p{margin-top:12px;}
  .header-summary strong{color:#fff;font-weight:700;}
  .header-bottom-rule{width:46px;height:3px;background:var(--lime);margin-top:26px;}

  /* METRICS */
  .metrics{background:var(--navy-dark);display:grid;grid-template-columns:repeat(4,1fr);border-top:3px solid var(--lime);}
  .metric{padding:16px 12px;text-align:center;border-right:1px solid rgba(255,255,255,0.07);}
  .metric:last-child{border-right:none;}
  .metric-num{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--lime);display:block;line-height:1;margin-bottom:3px;}
  .metric-num.white{color:#fff;}
  .metric-label{font-size:9px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);line-height:1.3;}

  /* PHOTO */
  .photo-wrap{width:100%;height:420px;overflow:hidden;}
  .photo-wrap img{width:100%;height:100%;object-fit:cover;object-position:center 40%;}

  .comp-photo-wrap{width:100%;overflow:hidden;border-radius:4px;margin-top:16px;border:1px solid var(--border);background:var(--off-white);}
  .comp-photo-wrap img{width:100%;height:auto;display:block;object-fit:contain;}
  .comp-photo-caption{font-size:10.5px;color:var(--mid);margin-top:6px;font-style:italic;}

  /* QUICK FACTS — below photo */
  .quick-facts{display:grid;grid-template-columns:repeat(6,1fr);background:var(--navy);}
  .qf-item{padding:14px 10px;text-align:center;border-right:1px solid rgba(255,255,255,0.08);}
  .qf-item:last-child{border-right:none;}
  .qf-val{font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:#fff;display:block;line-height:1;margin-bottom:3px;}
  .qf-label{font-size:8.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);}

  .section{padding:32px 48px 0;}
  .rule{height:3px;background:var(--navy);margin:32px 0 0;position:relative;}
  .rule::after{content:'';position:absolute;left:0;top:0;width:50px;height:3px;background:var(--lime);}
  .eyebrow{font-size:10px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--lime-dark);margin-bottom:4px;margin-top:8px;}
  .h2{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:700;text-transform:uppercase;color:var(--navy);letter-spacing:0.02em;margin-bottom:14px;}
  .body{font-size:13.5px;color:var(--text-light);line-height:1.8;}
  .body strong{color:var(--navy);font-weight:600;}
  .body p + p{margin-top:10px;}

  /* OVERVIEW GRID */
  .overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:18px;border:1px solid var(--border);border-radius:4px;overflow:hidden;}
  .ov-item{display:flex;align-items:stretch;border-bottom:1px solid var(--border);}
  .ov-item:nth-last-child(-n+2){border-bottom:none;}
  .ov-key{background:var(--navy);color:rgba(255,255,255,0.65);font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:10px 14px;min-width:130px;display:flex;align-items:center;}
  .ov-val{background:var(--white);font-size:13px;color:var(--navy);font-weight:600;padding:10px 14px;flex:1;display:flex;align-items:center;border-left:1px solid var(--border);}
  .ov-item:nth-child(odd){border-right:1px solid var(--border);}

  /* TABLES */
  .table{width:100%;border-collapse:collapse;margin-top:16px;font-size:12.5px;}
  .table th{background:var(--navy);color:rgba(255,255,255,0.75);font-size:9.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:10px 12px;text-align:left;}
  .table th.num{text-align:right;}
  .table td{padding:9px 12px;border-bottom:1px solid var(--light);color:var(--text-light);}
  .table td.num{text-align:right;font-variant-numeric:tabular-nums;}
  .table td.label{color:var(--navy);font-weight:600;}
  .table td.green{color:#2E7D32;font-weight:600;}
  .table td.red{color:#C0392B;}
  .table tr.total td{background:var(--off-white);font-weight:700;color:var(--navy);border-top:2px solid var(--navy);}
  .table tr.noi td{background:rgba(138,175,40,0.1);font-weight:700;color:var(--lime-dark);border-top:2px solid var(--lime);}
  .table tr.comp-row td{background:#F0F2F4;font-style:italic;}
  .table-scroll{overflow-x:auto;}

  /* HIGHLIGHTS */
  .highlights{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;}
  .hl-card{background:var(--off-white);border:1px solid var(--border);border-left:4px solid var(--navy);padding:15px 17px;border-radius:0 4px 4px 0;}
  .hl-head{font-size:12.5px;font-weight:700;color:var(--navy);margin-bottom:4px;}
  .hl-body{font-size:11.5px;color:var(--text-light);line-height:1.6;}

  .footnote{font-size:11px;color:var(--mid);font-style:italic;margin-top:10px;}
  .disclaimer{font-size:10px;color:var(--mid);line-height:1.5;margin-top:28px;padding:0 48px;font-style:italic;}

  .footer{background:var(--navy);padding:26px 48px;margin-top:40px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  .footer-left{font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#fff;}
  .footer-left span{color:var(--lime);}
  .footer-contacts{display:flex;gap:40px;}
  .footer-contact{font-size:11.5px;color:rgba(255,255,255,0.7);line-height:1.6;}
  .footer-contact strong{color:#fff;font-size:12px;display:block;margin-bottom:2px;}
  .footer-tag{font-size:9px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--lime);margin-top:8px;}

  @media (max-width:640px){
    .header{padding:18px 20px;}
    .header-address{font-size:30px;}
    .header-sub{font-size:16px;}
    .header-summary{font-size:14px;}
    .metrics{grid-template-columns:repeat(2,1fr);}
    .metric{border-bottom:1px solid rgba(255,255,255,0.07);}
    .quick-facts{grid-template-columns:repeat(2,1fr);}
    .qf-item{border-bottom:1px solid rgba(255,255,255,0.08);}
    .section{padding:26px 20px 0;}
    .overview-grid{grid-template-columns:1fr;}
    .ov-item:nth-child(odd){border-right:none;}
    .ov-item{border-bottom:1px solid var(--border);}
    .highlights{grid-template-columns:1fr;}
    .footer{padding:22px 20px;flex-direction:column;align-items:flex-start;}
    .disclaimer{padding:0 20px;}
  }
</style>

